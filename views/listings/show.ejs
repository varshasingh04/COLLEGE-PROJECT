<% layout('layouts/boilerplate') %>
<div class="listing-show">
  <div class="row">
    <div class="col-lg-8">
      <h2><%= listing.title %></h2>
      <p class="text-muted"><%= listing.location %><% if (listing.locality) { %>, <%= listing.locality %><% } %> · <%= listing.country %></p>
      <% if (listing.image && listing.image.url) { %>
        <img src="<%= listing.image.url %>" class="img-fluid rounded mb-3" alt="" style="max-height: 400px; width: 100%; object-fit: cover;">
      <% } %>
      <div class="card mb-3">
        <div class="card-body">
          <h5 class="card-title">Details</h5>
          <p class="card-text"><%= listing.description %></p>
          <ul class="list-unstyled mb-0">
            <li><strong>Price:</strong> ₹<%= listing.price.toLocaleString('en-IN') %></li>
            <% if (listing.area) { %><li><strong>Area:</strong> <%= listing.area %> sq ft</li><% } %>
            <% if (listing.propertyType) { %><li><strong>Type:</strong> <%= listing.propertyType %></li><% } %>
            <% if (listing.bedrooms) { %><li><strong>Bedrooms:</strong> <%= listing.bedrooms %></li><% } %>
            <% if (listing.bathrooms) { %><li><strong>Bathrooms:</strong> <%= listing.bathrooms %></li><% } %>
          </ul>
        </div>
      </div>
      <% const ownerId = listing.owner && listing.owner._id ? listing.owner._id.toString() : null; %>
      <% const isOwner = currUser && ownerId && ownerId === currUser._id.toString(); %>
      <% if (isOwner) { %>
        <div class="d-flex gap-2">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning">Edit</a>
          <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="d-inline">
            <button type="submit" class="btn btn-danger">Delete</button>
          </form>
        </div>
      <% } else if (currUser) { %>
        <a href="/listings/<%= listing._id %>/contact" class="btn btn-primary btn-lg"><i class="fa-solid fa-envelope me-1"></i> Contact Seller</a>
      <% } else { %>
        <p><a href="/choose-role">Login</a> to contact the seller.</p>
      <% } %>
    </div>
    <div class="col-lg-4">
      <div class="card">
        <div class="card-body">
          <h6 class="card-title">Listed by</h6>
          <% if (listing.owner && listing.owner.username) { %>
            <p class="mb-0"><strong><%= listing.owner.username %></strong></p>
            <% if (!isOwner && currUser) { %>
              <a href="/listings/<%= listing._id %>/contact" class="btn btn-outline-primary btn-sm mt-2">Message seller</a>
            <% } %>
          <% } else { %>
            <p class="mb-0 text-muted">Seller info not available</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <% if (currUser && !isOwner) { %>
    <hr class="my-4">
    <h4>Leave a review</h4>
    <form action="/listings/<%= listing.id %>/reviews" method="POST" class="mb-4">
      <div class="mb-3">
        <label for="rating" class="form-label">Rating (1–5)</label>
        <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range" value="3" required>
      </div>
      <div class="mb-3">
        <label for="comment" class="form-label">Your review</label>
        <textarea name="review[comment]" id="comment" class="form-control" rows="3" required placeholder="Your review..."></textarea>
      </div>
      <button type="submit" class="btn btn-outline-dark">Submit review</button>
    </form>
  <% } %>

  <hr>
  <h4>Reviews</h4>
  <div class="row">
    <% (listing.reviews || []).forEach(function(review) { %>
      <div class="col-md-6 mb-3">
        <div class="card">
          <div class="card-body">
            <h6 class="card-title"><%= review.author && review.author.username ? review.author.username : 'Unknown user' %></h6>
            <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
            <p class="card-text"><%= review.comment %></p>
            <% if (currUser && review.author && review.author._id && review.author._id.toString() === currUser._id.toString()) { %>
              <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            <% } %>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
  <% if (!listing.reviews || listing.reviews.length === 0) { %>
    <p class="text-muted">No reviews yet.</p>
  <% } %>
</div>
