<% layout('layouts/boilerplate') %>
<div class="listings-page">
  <h2 class="mb-4">Find a Property</h2>

  <div class="filters-card card mb-4">
    <div class="card-body">
      <form method="GET" action="/listings" class="row g-3 align-items-end" id="filter-form">
        <div class="col-md-2">
          <label class="form-label">Min price (₹)</label>
          <input type="number" name="priceMin" class="form-control" placeholder="0" value="<%= query.priceMin || '' %>" min="0">
        </div>
        <div class="col-md-2">
          <label class="form-label">Max price (₹)</label>
          <input type="number" name="priceMax" class="form-control" placeholder="Any" value="<%= query.priceMax || '' %>" min="0">
        </div>
        <div class="col-md-2">
          <label class="form-label">Locality</label>
          <input type="text" name="locality" class="form-control" placeholder="e.g. Koramangala" value="<%= query.locality || '' %>">
        </div>
        <div class="col-md-2">
          <label class="form-label">Min area (sq ft)</label>
          <input type="number" name="areaMin" class="form-control" placeholder="0" value="<%= query.areaMin || '' %>" min="0">
        </div>
        <div class="col-md-2">
          <label class="form-label">Max area (sq ft)</label>
          <input type="number" name="areaMax" class="form-control" placeholder="Any" value="<%= query.areaMax || '' %>" min="0">
        </div>
        <div class="col-md-2">
          <label class="form-label">Property type</label>
          <select name="propertyType" class="form-select">
            <option value="all" <%= (query.propertyType || 'all') === 'all' ? 'selected' : '' %>>All</option>
            <option value="apartment" <%= query.propertyType === 'apartment' ? 'selected' : '' %>>Apartment</option>
            <option value="house" <%= query.propertyType === 'house' ? 'selected' : '' %>>House</option>
            <option value="villa" <%= query.propertyType === 'villa' ? 'selected' : '' %>>Villa</option>
            <option value="plot" <%= query.propertyType === 'plot' ? 'selected' : '' %>>Plot</option>
            <option value="commercial" <%= query.propertyType === 'commercial' ? 'selected' : '' %>>Commercial</option>
            <option value="pg" <%= query.propertyType === 'pg' ? 'selected' : '' %>>PG</option>
            <option value="other" <%= query.propertyType === 'other' ? 'selected' : '' %>>Other</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label">Bedrooms (min)</label>
          <select name="bedrooms" class="form-select">
            <option value="any" <%= (query.bedrooms || 'any') === 'any' ? 'selected' : '' %>>Any</option>
            <option value="1" <%= query.bedrooms === '1' ? 'selected' : '' %>>1+</option>
            <option value="2" <%= query.bedrooms === '2' ? 'selected' : '' %>>2+</option>
            <option value="3" <%= query.bedrooms === '3' ? 'selected' : '' %>>3+</option>
            <option value="4" <%= query.bedrooms === '4' ? 'selected' : '' %>>4+</option>
          </select>
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-filter me-1"></i> Apply</button>
        </div>
      </form>
    </div>
  </div>

  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <% (allListings || []).forEach(function(listing) { %>
      <div class="col">
        <a href="/listings/<%= listing._id %>" class="listing-link text-decoration-none text-dark">
          <div class="card h-100 listing-card">
            <% if (listing.image && listing.image.url) { %>
              <img src="<%= listing.image.url %>" class="card-img-top" alt="" style="height: 200px; object-fit: cover;">
            <% } else { %>
              <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;"><i class="fa-solid fa-image fa-3x text-muted"></i></div>
            <% } %>
            <div class="card-body">
              <h5 class="card-title"><%= listing.title %></h5>
              <p class="card-text text-primary fw-bold mb-1">₹<%= listing.price.toLocaleString('en-IN') %></p>
              <p class="card-text small text-muted mb-0">
                <%= listing.location %><% if (listing.locality) { %>, <%= listing.locality %><% } %>
                <% if (listing.area) { %> · <%= listing.area %> sq ft<% } %>
                <% if (listing.bedrooms) { %> · <%= listing.bedrooms %> BHK<% } %>
              </p>
            </div>
          </div>
        </a>
      </div>
    <% }); %>
  </div>
  <% if (!allListings || allListings.length === 0) { %>
    <p class="text-muted mt-4">No properties match your filters. Try adjusting the filters above.</p>
  <% } %>
</div>
